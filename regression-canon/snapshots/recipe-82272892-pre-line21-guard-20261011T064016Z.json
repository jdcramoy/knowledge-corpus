			code_output_schema_json="[{\"name\": \"filtered_records_json\", \"label\": \"Filtered records JSON\", \"type\": \"string\", \"optional\": false, \"control_type\": \"text-area\"}, {\"name\": \"filtered_records\", \"label\": \"Filtered records\", \"type\": \"array\", \"of\": \"object\", \"optional\": false, \"control_type\": \"text\", \"properties\": [{\"name\": \"index_key\", \"label\": \"Index key\", \"type\": \"string\", \"optional\": false, \"control_type\": \"text\", \"parent\": [\"filtered_records\", \"r\"]}, {\"name\": \"capability_id\", \"label\": \"Capability ID\", \"type\": \"string\", \"optional\": false, \"control_type\": \"text\", \"parent\": [\"filtered_records\", \"r\"]}, {\"name\": \"service\", \"label\": \"Service\", \"type\": \"string\", \"optional\": false, \"control_type\": \"text\", \"parent\": [\"filtered_records\", \"r\"]}, {\"name\": \"intent_key\", \"label\": \"Intent key\", \"type\": \"string\", \"optional\": false, \"control_type\": \"text\", \"parent\": [\"filtered_records\", \"r\"]}, {\"name\": \"activation\", \"label\": \"Activation\", \"type\": \"string\", \"optional\": false, \"control_type\": \"text\", \"parent\": [\"filtered_records\", \"r\"]}, {\"name\": \"risk\", \"label\": \"Risk\", \"type\": \"string\", \"optional\": false, \"control_type\": \"text\", \"parent\": [\"filtered_records\", \"r\"]}, {\"name\": \"confirmation\", \"label\": \"Confirmation\", \"type\": \"string\", \"optional\": false, \"control_type\": \"text\", \"parent\": [\"filtered_records\", \"r\"]}, {\"name\": \"idempotency\", \"label\": \"Idempotency\", \"type\": \"string\", \"optional\": false, \"control_type\": \"text\", \"parent\": [\"filtered_records\", \"r\"]}, {\"name\": \"retry\", \"label\": \"Retry\", \"type\": \"string\", \"optional\": false, \"control_type\": \"text\", \"parent\": [\"filtered_records\", \"r\"]}, {\"name\": \"projection_json\", \"label\": \"Projection JSON\", \"type\": \"string\", \"optional\": false, \"control_type\": \"text\", \"parent\": [\"filtered_records\", \"r\"]}, {\"name\": \"input_contract_json\", \"label\": \"Input contract JSON\", \"type\": \"string\", \"optional\": false, \"control_type\": \"text\", \"parent\": [\"filtered_records\", \"r\"]}, {\"name\": \"request_contract_json\", \"label\": \"Request contract JSON\", \"type\": \"string\", \"optional\": false, \"control_type\": \"text\", \"parent\": [\"filtered_records\", \"r\"]}, {\"name\": \"response_contract_json\", \"label\": \"Response contract JSON\", \"type\": \"string\", \"optional\": false, \"control_type\": \"text\", \"parent\": [\"filtered_records\", \"r\"]}, {\"name\": \"scope_contract_json\", \"label\": \"Scope contract JSON\", \"type\": \"string\", \"optional\": false, \"control_type\": \"text\", \"parent\": [\"filtered_records\", \"r\"]}, {\"name\": \"execution_policy_json\", \"label\": \"Execution policy JSON\", \"type\": \"string\", \"optional\": false, \"control_type\": \"text\", \"parent\": [\"filtered_records\", \"r\"]}, {\"name\": \"contract_version\", \"label\": \"Contract version\", \"type\": \"string\", \"optional\": false, \"control_type\": \"text\", \"parent\": [\"filtered_records\", \"r\"]}, {\"name\": \"policy_version\", \"label\": \"Policy version\", \"type\": \"string\", \"optional\": false, \"control_type\": \"text\", \"parent\": [\"filtered_records\", \"r\"]}, {\"name\": \"rank\", \"label\": \"Rank\", \"type\": \"integer\", \"optional\": false, \"control_type\": \"integer\", \"parent\": [\"filtered_records\", \"r\"]}, {\"name\": \"updated_at\", \"label\": \"Updated at\", \"type\": \"string\", \"optional\": false, \"control_type\": \"text\", \"parent\": [\"filtered_records\", \"r\"]}]}, {\"name\": \"filtered_count\", \"label\": \"Filtered count\", \"type\": \"integer\", \"optional\": false, \"control_type\": \"integer\"}, {\"name\": \"preserved_reviewed\", \"label\": \"Preserved reviewed rows\", \"type\": \"integer\", \"optional\": false, \"control_type\": \"integer\"}]",
