 ? 'read' : 'write_shadow',\n    'pagination' => nil,\n    'provider_batch' => { 'contract' => 'workspace-semantic-provider-batch/1.0', 'root_url' => operation['base_url'].split('/').first(3).join('/') + '/', 'batch_path' => operation['batch_path'], 'max_members' => 100 },\n    'schema_checksum' => digest({ 'path' => operation['path'], 'method' => operation['method'], 'parameters' => operation['parameters'], 'request_ref' => operation['request_ref'], 'response_ref' => operation['response_ref'], 'body_contract' => body_contract, 'scopes' => operation['scopes'] }),\n    'arguments' => arguments\n  }\nend\n\n# Derive standards-based semantic content envelopes from Discovery shape. This\n# recognizes no service, capability, or endpoint name: the provider document\n# itself must declare an opaque RFC-822/base64url field and a default-signature\n# read contract before the generic transport will enable this transform.\ndef rfc822_content_envelope(document, operation, all_operations)\n  request = dereference_schema(document, { '$ref' => operation['request_ref'] })\n  outer = request['properties']\n  return nil unless outer.is_a?(Hash)\n  envelope = outer.keys.sort.map do |body_field|\n    body_schema = dereference_schema(document, outer[body_field])\n    raw = (body_schema['properties'] || {})['raw']\n    raw_schema = dereference_schema(document, raw || {})\n    description = raw_schema['description'].to_s\n    next unless raw_schema['type'] == 'string' && description.match?(/RFC\\s*2822/i) && description.match?(/base64url/i)\n    { 'body_field' => body_field, 'raw_field' => 'raw' }\n  end.compact.first\n  return nil unless envelope\n  preflight = all_operations.select { |candidate| SAFE_METHODS.include?(candidate['method']) }.sort_by { |candidate| candidate['capability_id'] }.map do |candidate|\n    response = dereference_schema(document, { '$ref' => candidate['response_ref'] })\n    collection = (response['properties'] || {}).keys.sort.map do |array_name|\n      array_sch