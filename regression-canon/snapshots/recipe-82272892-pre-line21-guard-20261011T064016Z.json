arameter['type'] || 'string'\n      type = parameter['repeated'] == true ? 'array' : provider_type\n      output[name] = {\n        'location' => parameter['location'] || 'query',\n        'required' => !!parameter['required'],\n        'type' => type,\n        'enum' => parameter['enum'],\n        'minimum' => parameter['minimum'],\n        'maximum' => parameter['maximum'],\n        'has_default' => parameter.key?('default'),\n        'default' => parameter.key?('default') ? typed_discovery_default(provider_type, parameter['default']) : nil\n      }\n    end\n    result << {\n      'capability_id' => service + '.' + path.join('.') + '.' + operation + '@' + doc.fetch('version'),\n      'service' => service,\n      'resource' => path.join('.'),\n      'operation' => operation,\n      'method' => spec.fetch('httpMethod'),\n      'path' => spec.fetch('path'),\n      'parameters' => parameters,\n      'request_ref' => spec.dig('request', '$ref'),\n      'response_ref' => spec.dig('response', '$ref'),\n      'scopes' => spec['scopes'] || [],\n      'base_url' => doc.fetch('rootUrl', '') + doc.fetch('servicePath', ''),\n      'batch_path' => doc['batchPath']\n    }\n  end\n  result\nend\n\n# Derive a bounded response projection from the public Discovery schema.\n# This is structural schema traversal, not a service or endpoint presentation\n# rule. A semantic overlay may replace this default with a curated projection.\ndef dereference_schema(document, schema, seen = [])\n  return {} unless schema.is_a?(Hash)\n  ref = schema['$ref']\n  return schema if ref.blank?\n  return {} unless ref.is_a?(String) && !seen.include?(ref)\n  dereference_schema(document, (document['schemas'] || {})[ref], seen + [ref])\nend\n\n# Rank primitive schema leaves using only reusable semantic field classes.\n# This deliberately has no provider, service, resource, or endpoint vocabulary.\ndef projection_priority(path)\n  parts = path.to_s.split('.')\n  leaf = words(parts.last)\n  shallow = parts.length <= 2\n  return 0 if shallow && (leaf == 'id' || leaf.include?('next page token'))\n  return 1 if shallow && %w[name title summary subject label display displayname].any? { |term| leaf == term || leaf.include?(term + ' ') || leaf.end_with?(' ' + term) }\n  return 2 if shallow && %w[modified time updated time].include?(leaf)\n  return 3 if shallow && %w[created time published time].include?(leaf)\n  return 4 if shallow && %w[start end date time timestamp].any? { |term| leaf == term || leaf.end_with?(' ' + term) }\n  return 5 if shallow && %w[status state type mimetype mime kind].any? { |term| leaf == term || leaf.end_with?(' ' + term) }\n  return 6 if shallow && %w[url link uri].any? { |term| leaf == term || leaf.end_with?(' ' + term) }\n  return 7 if shallow\n  9\nend\ndef projection_paths(document, schema_ref, prefix = [], depth = 0, output = [])\n  schema = dereference_schema(document, schema_ref.is_a?(Hash) ? schema_ref : { '$ref' => schema_ref })\n  properties = schema['properties']\n  return output if !properties.is_a?(Hash) || depth > 3\n  properties.keys.sort.each do |name|\n    child = dereference_schema(document, properties[name])\n    path = prefix + [name]\n    if child['type'] == 'array'\n      item = dereference_schema(document, child['items'] || {})\n      projection_paths(document, item, path, depth + 1, output) if item['properties'].is_a?(Hash)\n    elsif child['properties'].is_a?(Hash)\n      projection_paths(document, child, path, depth + 1, output)\n    elsif %w[string integer number boolean].include?(child['type'])\n      output << path.join('.')\n    end\n  end\n  output.uniq.sort_by { |path| [projection_priority(path), path.split('.').length, path] }.first(8)\nend\n\n# Discover pagination structurally from the operation parameters and response\n# schema. The names are normalized from the Discovery document; no service or\n# endpoint mapping is maintained in recipe code.\ndef pagination_contract(document, operation)\n  response = dereference