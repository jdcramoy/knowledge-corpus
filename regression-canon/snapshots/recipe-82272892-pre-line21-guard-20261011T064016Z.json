'object' then value.is_a?(Hash)\n  else value.is_a?(String)\n  end\nend\n\n# Preserve semantic defaults already present in an authoritative registry tuple.\n# Discovery owns parameter existence, provider name, and type; the semantic\n# layer owns policy defaults such as a caller's primary resource. This is a\n# generic contract merge and never branches on service or capability.\ndef preserve_semantic_argument_defaults(current, discovered_arguments)\n  return discovered_arguments unless current.is_a?(Hash) && current['input_contract_json'].to_s.present?\n  prior = JSON.parse(current['input_contract_json'])\n  prior_arguments = prior['canonical_arguments']\n  return discovered_arguments unless prior_arguments.is_a?(Array)\n  prior_by_provider = prior_arguments.each_with_object({}) do |argument, output|\n    next unless argument.is_a?(Hash) && argument['provider_name'].to_s.present?\n    output[argument['provider_name']] = argument\n  end\n  discovered_arguments.map do |argument|\n    prior_argument = prior_by_provider[argument['provider_name']]\n    compatible_default = prior_argument.is_a?(Hash) && prior_argument['type'] == argument['type'] && prior_argument.key?('default') && !prior_argument['default'].nil? && typed_default_valid?(prior_argument['default'], argument['type'])\n    compatible_default ? argument.merge('default' => prior_argument['default'], 'required' => false) : argument\n  end\nrescue StandardError\n  discovered_arguments\nend\n\nraise 'REGISTRY_PAGE_INCOMPLETE' unless input['registry_continuation_token'].to_s.empty?\nexisting = JSON.parse(input.fetch('registry_rows_json')).each_with_object({}) { |row, output| output[row['index_key']] = row }\nsources = JSON.parse(input.fetch('documents_json')).map { |entry| [entry.fetch('service'), entry.fetch('document_json')] }\nrecords = []\nexceptions = []\nsources.each do |service, raw|\n  document = JSON.parse(raw)\n  service_operations = operations(service, document)\n  service_operations.each do |operation|\n    compiled = execution_binding(document, operation)\n    semantic_content_envelope = rfc822_content_envelope(document, operation, service_operations)\n    semantic_resource_reference = resource_action_reference_contract(operation, semantic_content_envelope)\n    semantic_content_envelope = nil if semantic_resource_reference\n    compiled['pagination'] = pagination_contract(document, operation)\n    if compiled['pagination'].is_a?(Hash)\n      limit_name = compiled['pagination']['canonical_limit_argument']\n      ceiling = compiled['pagination']['provider_max_items'].to_i\n      compiled['arguments'].each do |argument|\n        next unless argument['name'] == limit_name && argument['type'] == 'integer'\n        argument['maximum'] = ceiling if argument['maximum'].to_i <= 0 && ceiling.positive?\n      end\n    end\n    derived_projection = projection_paths(document, operation['response_ref'])\n    intent = [words(operation['operation']), words(operation['resource'])].reject(&:empty?).join(' ')\n    registry_key = operation['capability_id'] + '|' + intent\n    candidate_rows = existing.values.select { |row| row['capability_id'] == operation['capability_id'] }\n    candidate_rows = [existing[registry_key]] if candidate_rows.empty?\n    candidate_rows.each do |current|\n    compiled['arguments'] = preserve_semantic_argument_defaults(current, compiled['arguments'])\n    prior_binding = current && (JSON.parse(current['request_contract_json']) rescue {}).dig('execution_binding')\n    def compiler_contract_valid?(row, compiled, semantic_content_envelope, semantic_resource_reference)\n  input_contract = JSON.parse(row.fetch('input_contract_json'))\n  request_contract = JSON.parse(row.fetch('request_contract_json'))\n  return false unless input_contract['canonical_arguments'] == compiled['arguments']\n  return false unless request_contract.dig('execution_binding', 'pagination') == compiled['pagination']\n  return false unless request_contract['allowed_body_fields'] == compiled['body_fields']\n  return false unless request_contract['required_body_fields'] == compiled['body_required_fields']\n  policy = JSON.parse(row.fetch('execution_policy_json'))\n  return false unless policy['compiler_enabled'] == true\n  response = JSON.parse(row.fetch('response_contract_json'))\n  return false if policy['compiler_enabled'] == true && policy['execution_mode'] == 'read' && (!response['default_projection'].is_a?(Array) || response['default_projection'].empty?)\n  auto_generated = row['policy_version'].to_s.start_with?('auto/')\n  return false if auto_generated && response['projection_strategy'] != 'discovery_schema_rank_v5'\n  canonical_names = input_contract.fetch('canonical_arguments').map { |arg| arg.fetch('name') }\n  canonical_by_provider = compiled.fetch('canonical_argument_bindings').invert\n  rules = policy['runtime_compiler_rules']\n  return false unless rules.is_a?(Array)\n  expected_runtime_tokens = rules.each_with_object({}) do |rule, output|\n    next unless rule.is_a?(Hash) && rule['runtime_values'].is_a?(Hash)\n    rule['runtime_values'].each do |name, value|\n      output[name] = value['compiler_token'] if value.is_a?(Hash) && value['compiler_token'].to_s.start_with?('@runtime:')\n    end\n  end\n  return false unless request_contract.dig('execution_binding', 'runtime_argument_tokens') == expected_runtime_tokens\n  rule_ids = []\n  return false unless rules.all? do |rule|\n    next false unless rule.is_a?(Hash) && rule['rule_id'].to_s.present?\n    rule_ids << rule['rule_id']\n    fixed = rule.fetch('fixed_arguments', {})\n    runtime = rule.fetch('runtime_values', {})\n    next false unless fixed.is_a?(Hash) && runtime.is_a?(Hash)\n    (fixed.keys + runtime.keys).all? { |name| canonical_names.include?(name) }\n  end\n  selection = policy.dig('selection_contract')\n  return false unless selection.is_a?(Hash) && selection['argument_bindings'].is_a?(Array) && selection['body_bindings'].is_a?(Array) && selection['rule_bindings'].is_a?(Ar