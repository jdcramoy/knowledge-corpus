		invoke_custom_ruby_code_21 = workato_custom_code.invoke_custom_ruby_code(
			name="Preserve reviewed rows from re-upsert",
			code="require 'json'\n\n# The Discovery re-derivation produces fresh auto contracts for every\n# operation it walks. Rows that already carry a REVIEWED contract (policy\n# version pinned, e.g. 1.3.0 \u2014 build-generated, overlay-hardened, or\n# promoter-promoted) must never be re-upserted: the derivation would\n# downgrade them back to auto/1.0 stubs every tick (2026-10-03 downgrade\n# bug). Filter them out; the upsert then only writes new and still-auto rows.\n# Pills may arrive as JSON text or Ruby-inspect text \u2014 handle both.\ndef flexible_parse(value)\n  return value if value.is_a?(Array)\n  s = value.to_s\n  JSON.parse(s)\nrescue StandardError\n  begin\n    t = s.gsub(/(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)? [\\+\\-]\\d{4})/) { '\"' + Regexp.last_match(1) + '\"' }\n    t = t.gsub('=>', ':')\n    JSON.parse(t)\n  rescue StandardError\n    []\n  end\nend\n\n# Canonical deep-sorted JSON for byte-stable comparison (mirrors the\n# normalize step's canonicalization, which runs AFTER this step).\ndef canon(value)\n  if value.is_a?(Hash)\n    value.keys.sort.each_with_object({}) { |k, h| h[k] = canon(value[k]) }\n  elsif value.is_a?(Array)\n    value.map { |v| canon(v) }\n  else\n    value\n  end\nend\n\ndef canonical_json(raw)\n  return nil if raw.nil? || raw.to_s.strip.empty?\n  JSON.generate(canon(JSON.parse(raw)))\nrescue StandardError\n  nil\nend\n\n# Empty-input guard: a blank or null records_json payload (nothing compiled\n# this tick, or an upstream output pill resolved to nothing - the 2026-10-03\n# runs died here with JSON::ParserError \"783: unexpected token at ''\") is a\n# legitimate no-op state, not a failure. Skip the diff eval and return an\n# empty batch cleanly instead of raising.\nrecords_raw = input['records_json'].to_s.strip\nrecords = (records_raw.empty? || records_raw == 'null') ? [] : flexible_parse(records_raw)\nregistry_rows = flexible_parse(input['registry_rows_json'])\n\nreviewed_keys = {}\nlive_by_key = {}\nregistry_rows.each do |row|\n  next unless row.is_a?(Hash)\n  live_by_key[row['index_key']] = row\n  next unless row['policy_version'].present? && row['policy_version'] != 'auto/1.0'\n  reviewed_keys[row['index_key']] = true\nend\n\n# Contracts are byte-stable across runs (the derivation canonicalizes them\n# downstream). An auto row whose every contract field is canonically\n# identical to its live counterpart carries no change: skipping its upsert\n# removes the per-tick write churn on the registry that races the gateway's\n# reads (2026-10-06 read-replica race class).\nCONTRACT_FIELDS = ['input_contract_json', 'request_contract_json', 'response_contract_json', 'scope_contract_json', 'execution_policy_json']\n\nskipped_unchanged = 0\nfiltered = records.reject do |record|\n  if reviewed_keys[record['index_key']]\n    next true\n  end\n  live = live_by_key[record['index_key']]\n  if live.is_a?(Hash) && CONTRACT_FIELDS.all? { |field| canonical_json(record[field]) == canonical_json(live[field]) }\n    skipped_unchanged += 1\n    next true\n  end\n  false\nend\n\n{ 'filtered_records' => filtered, 'filtered_count' => filtered.length, 'preserved_reviewed' => reviewed_keys.size, 'skipped_unchanged' => skipped_unchanged }",
