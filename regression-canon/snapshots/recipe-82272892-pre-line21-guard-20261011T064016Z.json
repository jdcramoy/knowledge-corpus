return false unless selection['body_bindings'].empty?\n  end\n  return false unless selection['rule_bindings'].all? { |binding| binding.is_a?(Hash) && binding['rule_id'].to_s.present? && rule_ids.include?(binding['rule_id']) }\n  if compiled['pagination'].is_a?(Hash)\n    limit_argument = compiled['pagination']['canonical_limit_argument']\n    return false unless selection['argument_bindings'].any? { |binding| binding['source'] == 'requested_limit' && binding['argument'] == limit_argument && binding['mode'] == 'cap_min' }\n  end\n  true\nrescue StandardError\n  false\nend\n\nif current && prior_binding && prior_binding['schema_checksum'] == compiled['schema_checksum'] && compiler_contract_valid?(current, compiled, semantic_content_envelope, semantic_resource_reference)\n      next\n    end\n    if current && prior_binding && (SAFE_METHODS.include?(prior_binding['http_method'].to_s) != SAFE_METHODS.include?(operation['method']))\n      exceptions << { 'audit_key' => 'discovery_exception|' + operation['capability_id'] + '|' + compiled['schema_checksum'], 'capability_id' => operation['capability_id'], 'service' => operation['service'], 'prior_checksum' => prior_binding['schema_checksum'], 'candidate_checksum' => compiled['schema_checksum'], 'change_type' => 'METHOD_CLASS_CHANGED_FAIL_CLOSED', 'candidate_method_count' => 1, 'candidate_json' => JSON.generate({ 'capability_id' => operation['capability_id'], 'prior_binding' => prior_binding, 'candidate_binding' => compiled }), 'status' => 'EXCEPTION' }\n      next\n    end\n    method_read = SAFE_METHODS.include?(operation['method'])\n    defaults = method_read ? { 'activation' => 'read_enabled', 'risk' => 'read', 'confirmation' => 'never', 'idempotency' => 'idempotent', 'retry' => 'safe' } : { 'activation' => 'write_shadow', 'risk' => 'external_side_effect', 'confirmation' => 'always', 'idempotency' => 'conditional', 'retry' => 'preconditioned_only' }\n    read_policy = { 'activation' => current ? current['activation'] : 