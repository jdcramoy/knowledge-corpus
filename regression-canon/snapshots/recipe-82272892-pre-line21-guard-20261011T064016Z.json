		# step: 22
		invoke_custom_ruby_code_22 = workato_custom_code.invoke_custom_ruby_code(
			name="Normalize pagination limit defaults in compiled registry records",
			code="require 'json'\n\n# Generic contract normalization for compiled registry records, with no service\n# or endpoint knowledge:\n# 1. A provider-declared pagination default (for example Drive's pageSize=100)\n#    is transport guidance, not semantic policy, and can exceed the reviewed\n#    result bound. The generic executor defaults an omitted limit to the\n#    reviewed maximum, so a paginated read's limit argument carries no default.\n# 2. The compiler-derived result collection path guesses from the response\n#    schema and can select a non-result array; the generic executor already\n#    infers the result collection from the reviewed response projection, so the\n#    guessed path is removed.\n# 3. Stored contract JSON must be byte-stable across runs when the derived\n#    content is unchanged. Object key order inside stored JSON and the\n#    iteration order of compiled argument arrays carry no contract meaning,\n#    but unstable ordering rewrites rows every run and defeats checksum-based\n#    drift and staleness detection. Stored contract JSON is therefore\n#    canonicalized: object keys are deep-sorted and canonical_arguments are\n#    ordered by name.\n# 4. Capability-sibling inheritance: an autonomous paraphrase row (auto/*)\n#    inherits the capability's reviewed semantic extensions instead of\n#    diverging from them: a curated sibling's response projection (the curated\n#    review owns mask safety) and any curated sibling media_transport\n#    descriptor whose reviewed intents list includes this row's intent.\n\ndef contract_canonical(value)\n  if value.is_a?(Hash)\n    sorted = {}\n    value.keys.sort.each do |key|\n      sorted[key] = contract_canonical(value[key])\n    end\n    sorted\n  elsif value.is_a?(Array)\n    value.map { |item| contract_canonical(item) }\n  else\n    value\n  end\nend\n\nCONTRACT_FIELDS = ['input_contract_json', 'request_contract_json', 'response_contract_json', 'scope_contract_json', 'execution_policy_json']\n\nrecords = JSON.parse(input['records_json'])\nrecords.group_by { |record| record['capability_id'] }.each_value do |siblings|\n  curated = siblings.select { |record| !record['policy_version'].to_s.start_with?('auto/') }\n  curated_projection = curated.map { |record| (JSON.parse(record['response_contract_json']) rescue {}).fetch('default_projection', nil) }.compact.find { |projection| projection.is_a?(Array) && projection.present? }\n  sibling_transports = curated.map { |record| (JSON.parse(record['execution_policy_json']) rescue {}).fetch('media_transport', nil) }.compact\n  siblings.each do |record|\n    next if curated.include?(record)\n    policy = JSON.parse(record['execution_policy_json'])\n    changed = false\n    if curated_projection.is_a?(Array) && curated_projection.present? && record['policy_version'].to_s.start_with?('auto/')\n      response = JSON.parse(record['response_contract_json'])\n      unless response['default_projection'] == curated_projection\n        response['default_projection'] = curated_projection\n        record['response_contract_json'] = JSON.generate(response)\n        changed = true\n      end\n    end\n    unless policy['media_transport'].is_a?(Hash)\n      row_intent = record['intent_key']\n      matched = sibling_transports.find { |transport| transport.is_a?(Hash) && transport['intents'].is_a?(Array) && transport['intents'].include?(row_intent) }\n      if matched.is_a?(Hash)\n        policy['media_transport'] = matched\n        record['execution_policy_json'] = JSON.generate(policy)\n        changed = true\n      end\n    end\n    record['updated_at'] = Time.now.utc.iso8601 if changed\n  end\nend\n\nrecords.each do |record|\n  request = JSON.parse(record['request_contract_json'])\n  pagination = request.dig('execution_binding', 'pagination')\n  changed = false\n  if pagination.is_a?(Hash)\n    limit_name = pagination['canonical_limit_argument']\n    if limit_name.present?\n      input_contract = JSON.parse(record['input_contract_json'])\n      (input_contract['canonical_arguments'] || []).each do |argument|\n        next unless argument.is_a?(Hash) && argument['name'] == limit_name && !argument['default'].nil?\n        argument['default'] = nil\n        changed = true\n      end\n      record['input_contract_json'] = JSON.generate(input_contract)\n    end\n    if pagination.key?('result_collection_path')\n      pagination.delete('result_collection_path')\n      request['execution_binding']['pagination'] = pagination\n      record['request_contract_json'] = JSON.generate(request)\n      changed = true\n    end\n  end\n  CONTRACT_FIELDS.each do |field|\n    raw = record[field]\n    next if raw.nil? || raw.to_s.empty?\n    parsed = JSON.parse(raw)\n    if field == 'input_contract_json' && parsed['canonical_arguments'].is_a?(Array)\n      parsed['canonical_arguments'] = parsed['canonical_arguments'].sort_by { |argument| argument['name'].to_s }\n    end\n    canonical = JSON.generate(contract_canonical(parsed))\n    next unless canonical != raw\n    record[field] = canonical\n    changed = true\n  end\n  record['updated_at'] = Time.now.utc.iso8601 if changed\nend\n{ 'records_json' => JSON.generate(records) }",
