n    # Generated contracts use direct Discovery argument slots. Curated semantic\n    # contracts retain their reviewed slot names and argument bindings across\n    # compatible Discovery refreshes; only provider argument renames are\n    # normalized above. This is generic policy preservation, not service routing.\n    if auto_generated\n      normalized_selection = {\n        'slots' => compiled['arguments'].map { |arg| { 'id' => arg['name'], 'type' => arg['type'], 'required' => arg['required'] } },\n        'argument_bindings' => compiled['arguments'].map { |arg| { 'slot' => arg['name'], 'argument' => arg['name'], 'mode' => 'copy' } },\n        'body_bindings' => compiled['body_fields'].present? ? [{ 'slot' => 'body', 'mode' => 'object_spread' }] : [],\n        'rule_bindings' => normalized_selection['rule_bindings']\n      }\n      normalized_selection['slots'] << { 'id' => 'body', 'type' => 'object', 'required' => compiled['body_required_fields'].present? } if compiled['body_fields'].present?\n    end\n    if semantic_resource_reference\n      normalized_selection = {\n        'slots' => [{ 'id' => semantic_resource_reference['slot'], 'type' => 'string', 'required' => true }],\n        'argument_bindings' => [],\n        'body_bindings' => [{ 'slot' => semantic_resource_reference['slot'], 'field' => semantic_resource_reference['body_field'], 'mode' => 'copy' }],\n        'rule_bindings' => []\n      }\n    elsif semantic_content_envelope\n      normalized_selection = {\n        'slots' => [\n          { 'id' => semantic_content_envelope['recipients_slot'], 'type' => 'array', 'required' => true },\n          { 'id' => semantic_content_envelope['subject_slot'], 'type' => 'string', 'required' => true },\n          { 'id' => semantic_content_envelope['body_slot'], 'type' => 'string', 'required' => true },\n          { 'id' => semantic_content_envelope['include_signature_slot'], 'type' => 'boolean', 'required' => false }\n        ],\n        'argument_bindings' => [], 'body_bindings' => [], 'rule_bindings' => []\n      }\n    end\n    if is_read && compiled['pagination'].is_a?(Hash)\n      limit_argument = compiled['pagination']['canonical_limit_argument']\n      bindings = normalized_selection['argument_bindings'].reject { |binding| binding.is_a?(Hash) && binding['source'] == 'requested_limit' }\n      bindings << { 'source' => 'requested_limit', 'argument' => limit_argument, 'mode' => 'cap_min' } if canonical_names.include?(limit_argument)\n      normalized_selection = normalized_selection.merge('argument_bindings' => bindings)\n    end\n    runtime_rules = normalize_runtime_rules(prior_policy['runtime_compiler_rules'], canonical_by_provider, canonical_names)\n    compiled['runtime_argument_tokens'] = runtime_rules.each_with_object({}) do |rule, output|\n      (rule['runtime_values'] || {}).each do |name, value|\n        output[name] = value['compiler_token'] if value.is_a?(Hash) && value['compiler_token'].to_s.start_with?('@runtime:')\n      end\n    end\n    request_contract['execution_binding']['runtime_argument_tokens'] = compiled['runtime_argument_tokens']\n    runtime_rule_ids = runtime_rules.map { |rule| rule['rule_id'] }\n    normalized_selection = normalized_selection.merge('rule_bindings' => normalized_selection['rule_bindings'].select { |binding| binding.is_a?(Hash) && runtime_rule_ids.include?(binding['rule_id']) })\n    compiler_enabled = is_read ? (response_contract['default_projection'].is_a?(Array) && response_contract['default_projection'].present?) : true\n    policy = { 'compiler_enabled' => compiler_enabled, 'execution_mode' => is_read ? 'read' : 'write_shadow', 'confirmation' => read_policy['confirmation'], 'idempotency' => read_policy['idempotency'], 'retry' => read_policy['retry'], 'preconditions' => prior_policy['preconditions'].is_a?(Array) ? prior_policy['preconditions'] : [], 'side_effect_fields' => prior_policy['side_effect_fields'].is_a?(Array) ? prior_policy['side_effect_fields'] : [], 'runtime_compiler_rules' => runtime_rules, 'selection_contract' => normalized_selection }.tap { |value| value['content_envelope'] = semantic_content_envelope if semantic_content_envelope; value['resource_reference_contract'] = semantic_resource_reference if semantic_resource_reference; value['media_transport'] = prior_policy['media_transport'] if prior_policy['media_transport'].is_a?(Hash) }\n    records << { 'index_key' => current ? current['index_key'] : registry_key, 'capability_id' => operation['capability_id'], 'service' => operation['service'], 'intent_key' => current ? current['intent_key'] : intent, 'activation' => read_policy['activation'], 'risk' => read_policy['risk'], 'confirmation' => read_policy['confirmation'], 'idempotency' => read_policy['idempotency'], 'retry' => read_policy['retry'], 'projection_json' => current ? current['projection_json'] : '[]', 'input_contract_json' => JSON.generate(input_contract), 'request_contract_json' => JSON.generate(request_contract), 'response_contract_json' => JSON.generate(response_contract), 'scope_contract_json' => JSON.generate({ 'alternatives' => operation['scopes'], 'selected_by_runtime' => false }), 'execution_policy_json' => JSON.generate(policy), 'contract_version' => current ? current['contract_version'] : '1.0.0', 'policy_version' => current ? current['policy_version'] : 'auto/1.0', 'rank' => current ? current['rank'] : 1000, 'updated_at' => Time.now.utc.iso8601 }\n    end\n  end\nend\n{ 'record_count' => records.length, 'records_json' => JSON.generate(records), 'exceptions_json' => JSON.generate(exceptions), 'registry_complete' => true }",
